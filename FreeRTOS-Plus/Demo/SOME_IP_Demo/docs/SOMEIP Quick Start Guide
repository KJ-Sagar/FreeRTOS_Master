### Experiment 2: Add New Service

**Create**: `custom_service.c`
```c
#include "someip_core/someip_core.h"

#define SERVICE_CUSTOM  0x2000
#define METHOD_GET_DATA 0x0001

static BaseType_t custom_handler(
    uint16_t service_id, uint16_t method_id,
    const uint8_t *req, uint32_t req_len,
    uint8_t *resp, uint32_t *resp_len,
    someip_return_code_t *ret)
{
    uint32_t data = 0x12345678;
    memcpy(resp, &data, 4);
    *resp_len = 4;
    *ret = SOMEIP_RET_OK;
    return pdPASS;
}

void CustomService_Init(void) {
    someip_register_service(SERVICE_CUSTOM, custom_handler);
}
```

**Update**: `demo_someip.c`
```c
void demo_someip_start(void) {
    HeartbeatService_Init();
    CustomService_Init();  // Add this line
    someip_server_start();
}
```

**Test**:
```python
# In Python client
sock.sendall(build_request(0x2000, 0x0001))  # Custom service
```

