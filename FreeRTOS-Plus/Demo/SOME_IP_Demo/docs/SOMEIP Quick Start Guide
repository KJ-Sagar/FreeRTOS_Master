## Step 5: Explore the Code (10 minutes)

### Key Files to Review

#### 1. Service Definition
**File**: `heartbeat_service.c`
```c
// How services are implemented
static BaseType_t heartbeat_handler(
    uint16_t service_id, uint16_t method_id,
    const uint8_t *req, uint32_t req_len,
    uint8_t *resp, uint32_t *resp_len,
    someip_return_code_t *ret)
{
    // Service logic here
    uint32_t alive = FreeRTOS_htonl(1U);
    memcpy(resp, &alive, sizeof(alive));
    *resp_len = sizeof(alive);
    *ret = SOMEIP_RET_OK;
    return pdPASS;
}

void HeartbeatService_Init(void) {
    someip_register_service(0x1234, heartbeat_handler);
    someip_eventgroup_register(&heartbeat_eventgroup);
}
```

#### 2. Server Main Loop
**File**: `someip_server.c`
```c
static void someip_server_task(void *arg) {
    // Accept TCP connections
    for (;;) {
        client_sock = FreeRTOS_accept(listen_sock, ...);
        
        // Allocate client slot
        ctx = someip_client_allocate(client_sock);
        
        // Spawn RX task for this client
        xTaskCreate(someip_client_task, ..., (void *)client_sock, ...);
    }
}
```

#### 3. Client RX Handler
**File**: `someip_client_task.c`
```c
void someip_client_task(void *arg) {
    Socket_t sock = (Socket_t)arg;
    
    for (;;) {
        // Receive SOME/IP message
        recv(sock, rx_buf, HEADER_SIZE, ...);
        
        // Parse header
        someip_ntoh_header(&hdr);
        
        // Handle Subscribe/Unsubscribe
        if (hdr.method_id == SOMEIP_METHOD_SUBSCRIBE) {
            someip_client_subscribe(ctx, ...);
            send_ack(sock);
        }
    }
}
```

#### 4. Notification Broadcaster
**File**: `someip_notification_task.c`
```c
void someip_notification_task(void *arg) {
    for (;;) {
        vTaskDelay(pdMS_TO_TICKS(2000));  // Every 2 seconds
        
        // Broadcast to all subscribed clients
        for (int i = 0; i < MAX_CLIENTS; i++) {
            if (someip_client_is_subscribed(&clients[i], ...)) {
                send_notification(&clients[i]);
            }
        }
    }
}
```

